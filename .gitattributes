# Normalize line endings so Windows (core.autocrlf=true) and other checkouts agree.
* text=auto eol=lf

# Windows scripts need CRLF (cmd.exe label/goto parsing, PowerShell signing).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never touch line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
*.dll binary
*.zip binary
*.db binary
*.sqlite binary
